{
  "name": "Default Theme",
  "version": "1.0.0",
  "description": "Clean, responsive default theme for Pagewright",
  "author": "Pagewright",
  
  "tokens": {
    "site_title": "My Pagewright Site",
    "site_description": "A simple, beautiful website built with Pagewright",
    "site_tagline": "Write your story",
    "logo_url": "",
    "primary_color": "#2563eb",
    "text_color": "#1f2937",
    "bg_color": "#ffffff",
    "border_color": "#e5e7eb",
    "hover_bg": "#f3f4f6",
    "font_family": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "max_width": "1200px",
    "footer_text": "© 2026 Pagewright. Built with minimal HTML and CSS."
  },
  
  "regions": {
    "header": {
      "enabled": true,
      "description": "Site header with logo and navigation"
    },
    "content": {
      "enabled": true,
      "description": "Main content area"
    },
    "sidebar": {
      "enabled": true,
      "description": "Optional sidebar for widgets",
      "widgets": []
    },
    "footer": {
      "enabled": true,
      "description": "Site footer"
    }
  },
  
  "allowed_components": [
    "hero",
    "callout",
    "button",
    "card",
    "grid",
    "image",
    "video",
    "quote",
    "code",
    "divider",
    "accordion",
    "tabs"
  ],
  
  "templates": {
    "layout": "templates/layout.php",
    "partials": {
      "header": "templates/partials/header.php",
      "footer": "templates/partials/footer.php",
      "sidebar": "templates/partials/sidebar.php",
      "navigation": "templates/partials/navigation.php"
    }
  },
  
  "assets": {
    "css": [
      "assets/theme.css"
    ],
    "js": [
      "assets/theme.js"
    ]
  },
  
  "settings": {
    "enable_sidebar": true,
    "enable_search": false,
    "enable_dark_mode": true,
    "enable_breadcrumbs": false,
    "posts_per_page": 10
  }
}
