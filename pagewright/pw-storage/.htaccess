# Pagewright Storage Directory Protection
# This directory contains sensitive data (users, secrets) and must never be accessible via web.

# Apache 2.4+ syntax
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 syntax (backward compatibility)
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Prevent PHP execution (defense in depth)
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Block all file types explicitly
<FilesMatch "\.(json|key|txt|log|php|inc|conf|sql|bak|old|tmp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Disable directory listing
Options -Indexes

# Disable script execution via CGI
Options -ExecCGI
RemoveHandler .cgi .pl .py .sh

# Additional security headers (if mod_headers is available)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
</IfModule>
