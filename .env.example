# Pagewright Environment Configuration
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control!

# =============================================================================
# Docker Configuration (Development Only)
# =============================================================================
# Port to expose the application on your local machine
# Default: 8880
# Change this if port 8880 is already in use by another service
PORT=8880

# Debug mode - shows detailed error messages (DO NOT enable in production)
# Default: false
# Set to 'true' or '1' to enable detailed error messages for development
DEBUG_MODE=false

# =============================================================================
# Base URL Configuration (Optional)
# =============================================================================
# If auto-detection doesn't work for your setup, set the full admin URL
# Example: https://yourdomain.com/pagewright/pw-admin
# Leave empty for auto-detection (recommended for most setups)
ADMIN_BASE_URL=

# =============================================================================
# Google OAuth Configuration
# =============================================================================
# Get credentials from: https://console.cloud.google.com/apis/credentials
# 1. Create a new OAuth 2.0 Client ID
# 2. Set authorized redirect URI to: https://yourdomain.com/pw-admin/oauth/callback.php
# 3. Copy the Client ID and Client Secret below

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# =============================================================================
# GitHub OAuth Configuration
# =============================================================================
# Get credentials from: https://github.com/settings/developers
# 1. Create a new OAuth App
# 2. Set authorization callback URL to: https://yourdomain.com/pw-admin/oauth/callback.php
# 3. Copy the Client ID and Client Secret below

GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# =============================================================================
# OpenAI API Configuration
# =============================================================================
# Get your API key from: https://platform.openai.com/api-keys
# This is used for the LLM-powered content editing features

OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: Customize the OpenAI model (default: gpt-4o)
# Available models: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo, etc.
OPENAI_MODEL=gpt-4o

# Optional: Use a custom OpenAI-compatible endpoint (e.g., Azure OpenAI)
# Default: https://api.openai.com/v1
# OPENAI_API_BASE_URL=https://api.openai.com/v1

# =============================================================================
# Development Notes
# =============================================================================
# For local development with Docker:
# 1. Copy this file to .env
# 2. Fill in your OAuth credentials (use http://localhost:8880/pw-admin/oauth/callback.php as redirect)
# 3. Add your OpenAI API key
# 4. Run: docker-compose up -d
#
# For production deployment:
# 1. Use HTTPS URLs for all OAuth callback URLs
# 2. Ensure STORAGE_PATH directory is writable by PHP
# 3. Never expose .env file via web server
# 4. Consider using environment variables directly in your hosting control panel
